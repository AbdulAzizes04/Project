# EARTH VISION-X Environment Variables Template
# Rename this file to .env and configure your credentials

# Google Earth Engine Credentials
GOOGLE_EARTH_ENGINE_PROJECT=your-gee-project-id
EARTH_ENGINE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EARTH_ENGINE_PRIVATE_KEY_PATH=path/to/private-key.json

# Optional: Copernicus Data Space Ecosystem / Sentinel Hub API
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret

# System Paths & Execution
DATABASE_URL=sqlite:///earth_vision_x.db
LOG_LEVEL=INFO
DEVICE=cpu
