# =========================================================
# AI Grievance Redressal System - Backend Environment
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =========================================================

# Application
APP_NAME="AI Grievance Redressal System"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Security
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# SQLite (default for development)
DATABASE_URL=sqlite:///./grievance.db
# PostgreSQL (for production) - uncomment and configure
# DATABASE_URL=postgresql://user:password@localhost:5432/grievance_db

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Paths (relative to backend/)
MODEL_DIR=app/ml/models
CLASSIFIER_MODEL_PATH=app/ml/models/complaint_classifier.pkl
PRIORITY_MODEL_PATH=app/ml/models/priority_predictor.pkl
VECTORIZER_PATH=app/ml/models/tfidf_vectorizer.pkl
PRIORITY_VECTORIZER_PATH=app/ml/models/priority_vectorizer.pkl

# Sentence Transformer Model (downloaded from HuggingFace)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Duplicate Detection Threshold (0-1, higher = stricter)
DUPLICATE_THRESHOLD=0.85

# AI Confidence Threshold (below this, flag for admin review)
LOW_CONFIDENCE_THRESHOLD=0.70

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/grievance.log
