# Application Settings
PROJECT_NAME="Explainable AI Career Recommendation System"
VERSION="1.0.0"
API_V1_PREFIX="/api"
DEBUG=True

# Security & Authentication
SECRET_KEY="career-recommendation-super-secret-jwt-key-2026-annamacharya"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Settings
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="career_ai_db"

# Database Connection URLs
# Primary MySQL (use pymysql driver):
DATABASE_URL="mysql+pymysql://root:your_mysql_password_here@localhost:3306/career_ai_db"
# Fallback SQLite DB path if MySQL is unreachable:
SQLITE_FALLBACK_PATH="./career_ai.db"

# Hybrid Recommendation Engine Weights (Total = 1.0)
WEIGHT_SKILLS=0.30
WEIGHT_ACADEMICS=0.15
WEIGHT_PROJECTS=0.15
WEIGHT_CERTIFICATIONS=0.10
WEIGHT_APTITUDE=0.10
